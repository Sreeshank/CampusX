{
  "name": "campusx-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:domain": "node --test tests/ride-transitions.test.mjs",
    "test:e2e": "playwright test",
    "functions:build": "npm --prefix functions run build",
    "format": "prettier --write src shared functions/src tests",
    "test:xchange:emulator": "npm run functions:build && npm exec --yes --package=firebase-tools@14.18.0 -- firebase emulators:exec --only firestore --project demo-campusx-person1 'node --test functions/tests/xchange.emulator.test.cjs'"
  },
  "dependencies": {
    "firebase": "12.4.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
